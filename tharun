files = {
"app.py": r'''
from flask import Flask, render_template, request, redirect, url_for, jsonify, session
from werkzeug.utils import secure_filename
from datetime import datetime
from pathlib import Path
import sqlite3
import os
import re

from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.pipeline import Pipeline

app = Flask(__name__)
app.secret_key = "civicroute-demo-secret"
BASE_DIR = Path(__file__).resolve().parent
DB_PATH = BASE_DIR / "civicroute.db"
UPLOAD_DIR = BASE_DIR / "uploads"
UPLOAD_DIR.mkdir(exist_ok=True)

ALLOWED_EXTENSIONS = {"png", "jpg", "jpeg", "webp"}

# -----------------------------
# Demo training data
# In a real hackathon, replace/expand this with your dataset.
# -----------------------------
TRAINING_DATA = [
    ("no water supply in our street", "Water Supply"),
    ("water has stopped for three days", "Water Supply"),
    ("drinking water is not coming", "Water Supply"),
    ("water pipe is not supplying water", "Water Supply"),
    ("we have no water in our area", "Water Supply"),

    ("power is gone in our village", "Electricity"),
    ("electricity supply is interrupted", "Electricity"),
    ("there is a power cut every day", "Electricity"),
    ("current is not available", "Electricity"),
    ("electric pole is damaged", "Electricity"),

    ("street light is not working", "Street Lighting"),
    ("our street is dark at night", "Street Lighting"),
    ("lamp on our road is broken", "Street Lighting"),
    ("no streetlight near my house", "Street Lighting"),
    ("street lights have stopped working", "Street Lighting"),

    ("there are potholes on the road", "Roads & Infrastructure"),
    ("our road is damaged", "Roads & Infrastructure"),
    ("road has become dangerous", "Roads & Infrastructure"),
    ("many potholes are making travel difficult", "Roads & Infrastructure"),
    ("repair the damaged village road", "Roads & Infrastructure"),

    ("garbage has not been collected", "Waste Management"),
    ("trash is piling up near our house", "Waste Management"),
    ("waste collection is not happening", "Waste Management"),
    ("rubbish has been left on the street", "Waste Management"),
    ("garbage bin is overflowing", "Waste Management"),

    ("drain is overflowing", "Drainage"),
    ("sewage water is on the road", "Drainage"),
    ("drainage is blocked", "Drainage"),
    ("dirty water is coming from the drain", "Drainage"),
    ("open drain is causing problems", "Drainage"),

    ("scholarship has not been received", "Education"),
    ("school has a problem", "Education"),
    ("education scholarship payment is delayed", "Education"),
    ("college certificate issue", "Education"),
    ("students need help with scholarship", "Education"),

    ("bus is not coming to our area", "Public Transport"),
    ("public bus service is poor", "Public Transport"),
    ("bus route has been stopped", "Public Transport"),
    ("no bus service in our village", "Public Transport"),
    ("bus is always overcrowded", "Public Transport"),

    ("birth certificate problem", "Government Documents"),
    ("income certificate is delayed", "Government Documents"),
    ("government document application issue", "Government Documents"),
    ("patta document problem", "Government Documents"),
    ("certificate has not been issued", "Government Documents"),

    ("government hospital has no doctor", "Public Health"),
    ("health centre service is poor", "Public Health"),
    ("hospital medicine is unavailable", "Public Health"),
    ("problem with public clinic", "Public Health"),
    ("government health service complaint", "Public Health"),
]

DEPARTMENT_MAP = {
    "Water Supply": "Water Supply Department",
    "Electricity": "Electricity Department",
    "Street Lighting": "Electricity Department",
    "Roads & Infrastructure": "Roads / Public Works Department",
    "Waste Management": "Municipal Sanitation Department",
    "Drainage": "Municipal Sanitation Department",
    "Education": "Education Department",
    "Public Transport": "Public Transport Department",
    "Government Documents": "Revenue / Public Service Department",
    "Public Health": "Public Health Department",
}

# Train a lightweight local model. No API key or huge model required.
texts = [x[0] for x in TRAINING_DATA]
labels = [x[1] for x in TRAINING_DATA]
classifier = Pipeline([
    ("tfidf", TfidfVectorizer(ngram_range=(1, 2), lowercase=True, sublinear_tf=True)),
    ("model", LogisticRegression(max_iter=1500))
])
classifier.fit(texts, labels)


def normalize_text(text):
    return re.sub(r"\s+", " ", text.strip())


def classify_complaint(text):
    text = normalize_text(text)
    probabilities = classifier.predict_proba([text])[0]
    classes = classifier.classes_
    best_index = probabilities.argmax()
    category = classes[best_index]
    confidence = float(probabilities[best_index])

    # Conservative routing for very unclear complaints.
    if confidence < 0.38:
        return {
            "category": "General / Manual Review",
            "department": "General Review Department",
            "priority": "LOW",
            "confidence": round(confidence * 100, 1),
            "reason": "The complaint is not clear enough for reliable automatic routing."
        }

    lower = text.lower()
    urgent_words = [
        "fire", "life threat", "dangerous", "electrocution",
        "major accident", "flood", "emergency"
    ]
    high_words = [
        "three days", "4 days", "five days", "week",
        "overflowing", "severe", "blocked", "danger"
    ]

    if any(w in lower for w in urgent_words):
        priority = "URGENT"
    elif any(w in lower for w in high_words):
        priority = "HIGH"
    else:
        priority = "MEDIUM"

    reason = f"The complaint language most closely matches the {category} service category."

    return {
        "category": category,
        "department": DEPARTMENT_MAP[category],
        "priority": priority,
        "confidence": round(confidence * 100, 1),
        "reason": reason
    }


def get_db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def init_db():
    conn = get_db()
    conn.execute("""
        CREATE TABLE IF NOT EXISTS complaints (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            complaint_id TEXT UNIQUE NOT NULL,
            citizen_name TEXT NOT NULL,
            mobile TEXT NOT NULL,
            location TEXT NOT NULL,
            complaint_text TEXT NOT NULL,
            photo TEXT,
            category TEXT NOT NULL,
            department TEXT NOT NULL,
            priority TEXT NOT NULL,
            confidence REAL NOT NULL,
            reason TEXT NOT NULL,
            status TEXT NOT NULL DEFAULT 'NEW',
            assigned_staff TEXT,
            resolution_notes TEXT,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL
        )
    """)
    conn.commit()
    conn.close()


def allowed_file(filename):
    return "." in filename and filename.rsplit(".", 1)[1].lower() in ALLOWED_EXTENSIONS


@app.route("/")
def home():
    return render_template("index.html")


@app.route("/submit", methods=["POST"])
def submit():
    name = normalize_text(request.form.get("name", ""))
    mobile = normalize_text(request.form.get("mobile", ""))
    location = normalize_text(request.form.get("location", ""))
    complaint_text = normalize_text(request.form.get("complaint", ""))

    if not name or not mobile or not location or len(complaint_text) < 8:
        return render_template(
            "index.html",
            error="Please fill all required fields and describe the problem clearly."
        )

    result = classify_complaint(complaint_text)

    photo_name = None
    photo = request.files.get("photo")
    if photo and photo.filename:
        if allowed_file(photo.filename):
            safe = secure_filename(photo.filename)
            timestamp = datetime.now().strftime("%Y%m%d%H%M%S%f")
            photo_name = f"{timestamp}_{safe}"
            photo.save(UPLOAD_DIR / photo_name)

    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    conn = get_db()
    cursor = conn.cursor()
    cursor.execute("""
        INSERT INTO complaints
        (complaint_id, citizen_name, mobile, location, complaint_text, photo,
         category, department, priority, confidence, reason, status,
         assigned_staff, resolution_notes, created_at, updated_at)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'NEW', NULL, '', ?, ?)
    """, (
        "TEMP", name, mobile, location, complaint_text, photo_name,
        result["category"], result["department"], result["priority"],
        result["confidence"], result["reason"], now, now
    ))
    row_id = cursor.lastrowid
    complaint_id = f"CMP-{1000 + row_id}"
    conn.execute(
        "UPDATE complaints SET complaint_id=? WHERE id=?",
        (complaint_id, row_id)
    )
    conn.commit()
    conn.close()

    return render_template(
        "success.html",
        complaint_id=complaint_id,
        result=result
    )


@app.route("/dashboard")
def dashboard():
    department = request.args.get("department", "All")
    conn = get_db()

    if department == "All":
        rows = conn.execute(
            "SELECT * FROM complaints ORDER BY id DESC"
        ).fetchall()
    else:
        rows = conn.execute(
            "SELECT * FROM complaints WHERE department=? ORDER BY id DESC",
            (department,)
        ).fetchall()

    stats = {
        "total": conn.execute("SELECT COUNT(*) FROM complaints").fetchone()[0],
        "new": conn.execute("SELECT COUNT(*) FROM complaints WHERE status='NEW'").fetchone()[0],
        "high": conn.execute(
            "SELECT COUNT(*) FROM complaints WHERE priority IN ('HIGH','URGENT')"
        ).fetchone()[0],
        "in_progress": conn.execute(
            "SELECT COUNT(*) FROM complaints WHERE status='IN PROGRESS'"
        ).fetchone()[0],
        "resolved": conn.execute(
            "SELECT COUNT(*) FROM complaints WHERE status='RESOLVED'"
        ).fetchone()[0],
    }
    conn.close()

    return render_template(
        "dashboard.html",
        complaints=rows,
        stats=stats,
        selected_department=department,
        departments=sorted(set(DEPARTMENT_MAP.values()) | {"General Review Department"})
    )


@app.route("/complaint/<complaint_id>")
def complaint_details(complaint_id):
    conn = get_db()
    complaint = conn.execute(
        "SELECT * FROM complaints WHERE complaint_id=?",
        (complaint_id,)
    ).fetchone()
    conn.close()

    if not complaint:
        return "Complaint not found", 404

    return render_template("details.html", complaint=complaint)


@app.route("/complaint/<complaint_id>/update", methods=["POST"])
def update_complaint(complaint_id):
    status = request.form.get("status", "NEW")
    staff = normalize_text(request.form.get("staff", ""))
    notes = normalize_text(request.form.get("notes", ""))

    valid_statuses = {"NEW", "ACKNOWLEDGED", "ASSIGNED", "IN PROGRESS", "RESOLVED", "REJECTED"}
    if status not in valid_statuses:
        return "Invalid status", 400

    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    conn = get_db()
    conn.execute("""
        UPDATE complaints
        SET status=?, assigned_staff=?, resolution_notes=?, updated_at=?
        WHERE complaint_id=?
    """, (status, staff, notes, now, complaint_id))
    conn.commit()
    conn.close()

    return redirect(url_for("complaint_details", complaint_id=complaint_id))


@app.route("/track", methods=["GET", "POST"])
def track():
    complaint = None
    error = None

    if request.method == "POST":
        complaint_id = normalize_text(request.form.get("complaint_id", "")).upper()
        conn = get_db()
        complaint = conn.execute(
            "SELECT * FROM complaints WHERE complaint_id=?",
            (complaint_id,)
        ).fetchone()
        conn.close()

        if not complaint:
            error = "Complaint ID not found."

    return render_template("track.html", complaint=complaint, error=error)


@app.route("/api/complaints")
def api_complaints():
    department = request.args.get("department", "All")
    conn = get_db()
    if department == "All":
        rows = conn.execute(
            "SELECT * FROM complaints ORDER BY id DESC"
        ).fetchall()
    else:
        rows = conn.execute(
            "SELECT * FROM complaints WHERE department=? ORDER BY id DESC",
            (department,)
        ).fetchall()
    conn.close()
    return jsonify([dict(row) for row in rows])


if __name__ == "__main__":
    init_db()
    print("CivicRoute running at http://127.0.0.1:5000")
    app.run(debug=True)
''',

