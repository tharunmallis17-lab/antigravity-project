    --surface: #ffffff;
    --bg: #f4f7fb;
    --primary: #1457d9;
    --primary-dark: #0d43ac;
    --soft: #edf4ff;
    --success: #15803d;
    --warning: #b45309;
    --danger: #b91c1c;
}

body {
    margin: 0;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--ink);
    background: var(--bg);
}

a { color: inherit; text-decoration: none; }

.topbar {
    height: 72px;
    padding: 0 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255,255,255,.96);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 10;
}

.brand {
    font-size: 22px;
    font-weight: 850;
    letter-spacing: -0.7px;
}

nav { display: flex; gap: 8px; }

nav a {
    padding: 10px 13px;
    border-radius: 9px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 650;
}

nav a:hover, nav a.active {
    background: var(--soft);
    color: var(--primary);
}

.page, .dashboard-page, .details-page {
    width: min(1180px, 90%);
    margin: 0 auto;
}

.hero {
    min-height: 360px;
    display: grid;
    grid-template-columns: 1fr 330px;
    gap: 50px;
    align-items: center;
}

.eyebrow {
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 1.5px;
    color: var(--primary);
}

.hero h1 {
    font-size: clamp(42px, 6vw, 68px);
    line-height: .98;
    letter-spacing: -3px;
    margin: 14px 0 20px;
}

.hero h1 span { color: var(--primary); }

.hero p {
    max-width: 650px;
    color: var(--muted);
    line-height: 1.7;
    font-size: 17px;
}

.hero-card {
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 15px 45px rgba(22, 42, 72, .08);
    display: grid;
    gap: 8px;
}

.hero-card span { color: var(--muted); font-size: 13px; }

.mini-icon {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: var(--primary);
    color: white;
    font-size: 13px;
    font-weight: 900;
}

.form-card, .panel, .track-card, .success-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 12px 40px rgba(22, 42, 72, .06);
}

.form-card { padding: 34px; margin-bottom: 60px; }

.section-heading, .panel-head, .dashboard-head, .details-head, .track-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.section-heading { margin-bottom: 25px; }
h2 { margin: 5px 0 0; font-size: 22px; }
h1 { letter-spacing: -1.5px; }
.required-note { color: var(--muted); font-size: 12px; }

form label {
    display: block;
    font-weight: 700;
    font-size: 13px;
    margin-bottom: 19px;
}

input, textarea, select {
    width: 100%;
    margin-top: 8px;
    border: 1px solid var(--line);
    border-radius: 11px;
    padding: 13px 14px;
    font: inherit;
    color: var(--ink);
    background: white;
    outline: none;
}

textarea { min-height: 145px; resize: vertical; }

input:focus, textarea:focus, select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(20,87,217,.10);
}

.grid { display: grid; gap: 20px; }
.grid.two { grid-template-columns: 1fr 1fr; }

.upload {
    border: 1px dashed #b8c4d4;
    border-radius: 12px;
    padding: 16px;
}

.upload input { border: 0; padding-left: 0; }

.info-box {
    background: var(--soft);
    border-radius: 12px;
    padding: 15px;
    margin: 5px 0 20px;
    display: grid;
    gap: 3px;
    font-size: 13px;
}

.info-box span { color: var(--muted); }

.primary-btn, .secondary-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    border-radius: 11px;
    padding: 13px 20px;
    border: 0;
    font-weight: 800;
    font-size: 14px;
    cursor: pointer;
}

.primary-btn { background: var(--primary); color: white; }
.primary-btn:hover { background: var(--primary-dark); }
.secondary-btn { background: #eef2f7; color: var(--ink); }
.link-btn { text-decoration: none; }

.alert {
    padding: 13px 16px;
    border-radius: 11px;
    margin-bottom: 20px;
    font-size: 14px;
}

.alert.error { background: #fff0f0; color: var(--danger); border: 1px solid #ffd0d0; }

.center-page {
    width: min(760px, 92%);
    margin: 70px auto;
}

.success-card, .track-card { padding: 40px; }

.success-mark {
    width: 62px;
    height: 62px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #dcfce7;
    color: var(--success);
    font-size: 30px;
    font-weight: 900;
    margin-bottom: 20px;
}

.success-card h1, .track-card h1 { font-size: 38px; margin: 10px 0; }
.success-card > p, .track-card > p { color: var(--muted); line-height: 1.6; }

.complaint-id {
    margin: 25px 0;
    padding: 20px;
    border-radius: 14px;
    background: var(--soft);
    display: grid;
    gap: 5px;
}
.complaint-id span, .result-grid span, .field span, .route-result span, .track-top span {
    color: var(--muted);
    font-size: 12px;
    display: block;
}
.complaint-id strong { font-size: 27px; color: var(--primary); }

.result-grid, .route-result {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}
.result-grid > div, .route-result > div {
    padding: 15px;
    background: #f7f9fc;
    border-radius: 12px;
}
.result-grid strong, .route-result strong { display: block; margin-top: 5px; font-size: 14px; }

.reason {
    margin-top: 18px;
    padding: 16px;
    border-left: 3px solid var(--primary);
    background: #f8fafc;
    border-radius: 0 10px 10px 0;
}
.reason p { margin: 6px 0 0; color: var(--muted); line-height: 1.55; font-size: 13px; }

.actions { display: flex; gap: 10px; margin-top: 25px; }

.dashboard-page { padding: 45px 0 70px; }
.dashboard-head { margin-bottom: 28px; }
.dashboard-head h1 { margin: 8px 0 5px; font-size: 38px; }
.dashboard-head p { color: var(--muted); margin: 0; }
.live { font-size: 13px; font-weight: 750; color: var(--success); }
.live i { display: inline-block; width: 8px; height: 8px; background: var(--success); border-radius: 50%; margin-right: 6px; }

.stats {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    margin-bottom: 22px;
}
.stat-card { background: white; border: 1px solid var(--line); border-radius: 15px; padding: 18px; }
.stat-card span { color: var(--muted); font-size: 12px; }
.stat-card strong { display: block; font-size: 28px; margin-top: 5px; }

.panel { padding: 25px; margin-bottom: 20px; }
.panel-head p { color: var(--muted); font-size: 13px; margin: 5px 0 0; }

.table-wrap { overflow-x: auto; margin-top: 20px; }
table { width: 100%; border-collapse: collapse; min-width: 900px; }
th { text-align: left; color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .7px; padding: 13px; border-bottom: 1px solid var(--line); }
td { padding: 15px 13px; border-bottom: 1px solid #edf0f4; font-size: 13px; }
.view-link { color: var(--primary); font-weight: 800; }
.empty { text-align: center; color: var(--muted); padding: 40px; }

.priority, .status {
    display: inline-block;
    border-radius: 99px;
    padding: 5px 9px;
    font-size: 10px;
    font-weight: 850;
    letter-spacing: .4px;
}
.priority.low { background: #eef2f7; color: #596579; }
.priority.medium { background: #fff7df; color: var(--warning); }
.priority.high { background: #ffedd5; color: #c2410c; }
.priority.urgent { background: #fee2e2; color: var(--danger); }
.status { background: #eaf1ff; color: var(--primary); }
.status.large { font-size: 11px; padding: 8px 12px; }

.details-page { padding: 45px 0 70px; }
.details-head { margin-bottom: 22px; }
.details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.details-grid .full { grid-column: 1 / -1; }
.panel h2 { margin-bottom: 20px; }
.field { padding: 13px 0; border-bottom: 1px solid #edf0f4; }
.complaint-text { margin-top: 20px; background: #f7f9fc; padding: 18px; border-radius: 12px; line-height: 1.6; }
.photo-box { margin-top: 18px; }
.photo-box img { max-width: 100%; max-height: 350px; border-radius: 12px; }
.track-form { display: grid; grid-template-columns: 1fr auto; gap: 10px; margin-top: 25px; }
.track-form input { margin-top: 0; }

@media (max-width: 800px) {
    nav a { font-size: 12px; padding: 8px; }
    .hero { grid-template-columns: 1fr; padding: 45px 0; }
    .hero-card { display: none; }
    .grid.two, .details-grid { grid-template-columns: 1fr; }
    .details-grid .full { grid-column: auto; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .form-card, .success-card, .track-card { padding: 25px; }
}

@media (max-width: 520px) {
    .topbar { padding: 0 3%; }
    nav { gap: 0; }
    nav a:nth-child(2) { display: none; }
    .page, .dashboard-page, .details-page { width: 94%; }
    .hero h1 { font-size: 45px; }
    .result-grid, .route-result { grid-template-columns: 1fr; }
    .track-form { grid-template-columns: 1fr; }
    .stats { grid-template-columns: 1fr 1fr; }
}
''',

