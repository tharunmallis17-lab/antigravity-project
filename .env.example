# CivicRoute AI Environment Configuration
# Copy to .env and supply your credentials as needed.

# Flask Application Secret Key (for sessions & token signing)
SECRET_KEY=civicroute_secret_hackathon_key_2026

# Google Gemini API Key (for LLM multi-issue extraction & prioritization)
GEMINI_API_KEY=

# Google Maps JavaScript API Key (for location picker and heatmap)
GOOGLE_MAPS_API_KEY=

# Firebase Configuration (Optional - Local persistence is automatically used when not provided)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
